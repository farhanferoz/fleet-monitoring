# A job that needs more than an address: copy to scrape.d/<name>.yml and edit.
# Prometheus reads every *.yml here at start (restart to apply). Each job name must be
# unique across all files. Format: Prometheus' scrape_config
# (https://prometheus.io/docs/prometheus/latest/configuration/configuration/#scrape_config).
scrape_configs:
  - job_name: my-app
    metrics_path: /metrics
    scheme: http
    # A password kept in a file in this site's secrets/ folder, never in this file.
    basic_auth:
      username: monitor
      password_file: /etc/prometheus/site/secrets/my_app_password
    static_configs:
      - targets: ["192.0.2.30:8080"]
        labels: {instance: other-machine}
