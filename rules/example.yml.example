# Alert rules: copy to rules/my-alerts.yml (any name ending in .yml) and edit, then
#   docker compose restart prometheus
# The *.example files are never loaded. Firing alerts show on the Prometheus "Alerts"
# page and in Grafana (Alerting > Alert rules, "Prometheus" data source). Nothing here
# sends an e-mail or message: that needs Alertmanager, which this stack does not include.
groups:
  - name: example
    rules:
      - alert: TargetDown
        expr: up == 0
        for: 5m
        annotations:
          summary: "{{ $labels.instance }} ({{ $labels.job }}) has not answered for 5 minutes"
      - alert: DiskAlmostFull
        expr: 100 * (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs"}) > 90
        for: 10m
        annotations:
          summary: "{{ $labels.instance }}: {{ $labels.mountpoint }} is {{ $value | printf \"%.0f\" }}% full"
