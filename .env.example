# Copy to .env and edit: cp .env.example .env
# Every line below is read by docker-compose.yml. Lines starting with # are comments.

# What this machine runs (comma-separated, no spaces):
#   hub     Prometheus: collects from every machine and stores the numbers
#   viewer  Grafana: the dashboards
#   agent   node-exporter: this machine's CPU, memory, disk, network, temperatures, AMD GPU
#   nvidia  NVIDIA GPU exporter (needs the NVIDIA Container Toolkit)
#   alerting  Alertmanager: sends alerts on (configure site/alertmanager.yml)
#   probes    blackbox exporter: checks websites and ports (site/scrape.d/probes.yml)
#   cadvisor  per-container CPU, memory and network
#   smartctl  disk health (SMART); runs privileged
#   logs      Loki: stores logs
#   logship   Alloy: sends this machine's container and system logs to Loki
# One machine, everything on it:      hub,viewer,agent      (add ,nvidia on NVIDIA)
# A further machine that is only watched:  agent             (or agent,nvidia)
COMPOSE_PROFILES=hub,viewer,agent

# Where this machine's own files are (copied from site.example) and where data is stored.
# Relative paths are relative to this folder.
SITE_DIR=./site
DATA_DIR=./data

# Which numeric user and group the containers run as. They store data in DATA_DIR and
# read the site folder, so this must be YOU: your numeric user id and group id,
# printed by:   printf '%s:%s\n' "$(id -u)" "$(id -g)"
RUN_AS=1000:1000

# Address Grafana and Prometheus listen on.
#   127.0.0.1  only this machine (reach it with an ssh tunnel; see the README)
#   0.0.0.0    every network the machine is on (anyone who can reach the port can see it)
#   a LAN or VPN address of this machine: only that network
BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Address and ports of the exporters (the programs that read this machine's sensors).
# Keep 127.0.0.1 unless a Prometheus on ANOTHER machine scrapes this one; then use this
# machine's LAN or VPN address. If you change a port, change it in site/targets/ too.
EXPORTER_BIND_ADDRESS=127.0.0.1
NODE_EXPORTER_PORT=9100
NVIDIA_EXPORTER_PORT=9835
BLACKBOX_PORT=9115
CADVISOR_PORT=8080
SMARTCTL_PORT=9633

# Alerting, logs (only read when those roles run).
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
# How long Loki keeps logs, in hours (720h = 30 days).
LOKI_RETENTION=720h
# Where Alloy and Grafana find Loki; leave unset when Loki runs on this machine.
#LOKI_URL=http://<loki machine>:3100
# The "host" label Alloy puts on this machine's logs.
HOST_LABEL=this-box

# How long Prometheus keeps data: a number plus d (days), w (weeks) or y (years).
RETENTION=30d

# Grafana only. Where Grafana finds Prometheus; leave unset when both run on this machine.
# When Prometheus runs on another machine: PROMETHEUS_URL=http://<its address>:9090
#PROMETHEUS_URL=
# Let people see the dashboards without signing in (read-only): true or false.
GRAFANA_ANONYMOUS=false
# The address people type to reach Grafana, if it sits behind a proxy or a DNS name.
#GRAFANA_ROOT_URL=https://grafana.example.org/

# Prometheus only. A login for Prometheus' own page and API: a Prometheus web config
# file inside the site folder (see site.example/web.yml.example). Unset = no login.
#PROMETHEUS_WEB_CONFIG=/etc/prometheus/site/web.yml
