# Copy to .env and edit: cp .env.example .env
# Every line below is read by docker-compose.yml. Lines starting with # are comments.

# Which numeric user and group the containers run as. They store data in ./data and read
# the files in this folder, so this must be YOU: your numeric user id and group id,
# printed by:   printf '%s:%s\n' "$(id -u)" "$(id -g)"
RUN_AS=1000:1000

# Grafana login: user "admin" and this password. There is no default on purpose; the
# stack refuses to start until you set it. Anonymous (not logged in) access is off.
GRAFANA_ADMIN_PASSWORD=

# Address Grafana and Prometheus listen on.
#   127.0.0.1  only this machine (reach it with an ssh tunnel; see the README)
#   0.0.0.0    every network the machine is on (anyone who can reach the port can see it)
#   a LAN or Tailscale address of this machine: only that network
BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Address and ports of the two exporters (the programs that read this machine's
# sensors). Keep 127.0.0.1 unless another Prometheus has to scrape this machine.
EXPORTER_BIND_ADDRESS=127.0.0.1
NODE_EXPORTER_PORT=9100
NVIDIA_EXPORTER_PORT=9835

# How long Prometheus keeps data: a number plus d (days), w (weeks) or y (years).
RETENTION=30d

# Which optional services to start. Empty for an AMD or GPU-less machine, "nvidia" to
# also start the NVIDIA GPU exporter (needs the NVIDIA Container Toolkit).
COMPOSE_PROFILES=
